DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cupcakes

# Local normalmente sin SSL; cambia a 'require' si tu Postgres local lo exige
PGSSLMODE=disable

# Solo para tus herramientas locales / serverless-offline
APP_PORT=3000
ENDPOINT_ROOT=cupcakeslife
CATEGORY_MODULE=categorias
