{
  "name": "cupcakeslife-functions",
  "version": "1.0.0",
  "description": "Backend serverless functions for CupcakesLife",
  "main": "src/handler.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "serverless offline start",
    "start:local": "serverless offline start --stage local",
    "deploy:dev": "serverless deploy --stage dev",
    "remove:dev": "serverless remove --stage dev",
    "deploy:prod": "NO USAR AUN serverless deploy --stage prod",
    "print": "serverless print",
    "print:local": "serverless print --stage local",
    "print:dev": "serverless print --stage dev",
    "print:prod": "serverless print --stage prod",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "create-domain:dev": "serverless create_domain --stage dev",
    "delete-domain:dev": "serverless delete_domain --stage dev",
    "check:node": "node -e \"const v=Number(process.versions.node.split('.')[0]); if(v !== 22){ console.error('Usa Node 22'); process.exit(1) }\"",
    "check:node:eval": "node -e \"const v=Number(process.versions.node.split('.')[0]); if(![22,24].includes(v)){ console.error('Usa Node 22 o 24'); process.exit(1) }\"",
    "verify": "npm run check:node:eval && npm test",
    "logs:cupcake": "serverless logs -f cupcake -t --stage dev"
  },
  "dependencies": {
    "aws-sdk": "^2.1691.0",
    "axios": "^1.6.7",
    "joi": "^17.12.1",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.3",
    "moment-timezone": "^0.5.45",
    "pg": "^8.11.3",
    "pg-promise": "^12.6.2",
    "sanitize-html": "^2.12.1",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "jest": "^30.0.4",
    "serverless": "3.40.0",
    "serverless-domain-manager": "^8.0.0",
    "serverless-offline": "13.6.0"
  },
  "_moduleAliases": {
    "@db": "db",
    "@": "src",
    "@src": "src",
    "@controllers": "src/controllers",
    "@services": "src/services",
    "@repositories": "src/repositories",
    "@utils": "src/utils",
    "@middlewares": "src/middlewares",
    "@validators": "src/validators",
    "@category": "src/category",
    "@cupcake": "src/cupcake",
    "@festivity": "src/festivity",
    "@ingredient": "src/ingredient",
    "@package": "src/package",
    "@recipe": "src/recipe",
    "@user": "src/user",
    "@environment": "environment"
  }
}
